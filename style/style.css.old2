:root {
    --bg: #0f172a;
    --bg-soft: #1e293b;
    --bg-hover: #1e293bcc;

    --border: #334155;
    --border-light: #ffffff1a;

    --text: #e2e8f0;
    --text-muted: #94a3b8;
    --text-dim: #64748b;

    --primary: #2563eb;
    --primary-hover: #3b82f6;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: var(--bg);
    color: var(--text);
    font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5;
}

.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
}

.navbar {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 100;
    padding: 14px 0;
    background: rgba(15, 23, 42);
    border-bottom: 2px solid var(--border-light);
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.5px;
}

.nav-links {
    display: flex;
    gap: 28px;
}

.nav-links a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.85rem;
    opacity: 0.75;
}

.nav-links a:hover {
    opacity: 1;
    color: var(--primary-hover);
}

.btn-tools {
    background-color: var(--primary);
    color: white;
    text-decoration: none;
    padding: 7px 14px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
}

.btn-tools:hover {
    background-color: var(--primary-hover);
}

.hero {
    padding: 120px 0 70px;
    text-align: center;
}

.hero h1 {
    font-size: 3rem;
    font-weight: 750;
    line-height: 1.2;
    margin-bottom: 20px;
}

.hero-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto 35px;
}

.btn-primary {
    padding: 11px 28px;
    border-radius: 7px;
    font-weight: 600;
    background-color: var(--primary);
    color: white;
    text-decoration: none;
    font-size: 0.95rem;
}

.btn-primary:hover {
    background-color: var(--primary-hover);
}

.features {
    padding: 70px 0;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
}

.card {
    background-color: var(--bg-soft);
    border: 1px solid var(--border);
    padding: 28px;
    border-radius: 14px;
}

.card:hover {
    border-color: var(--primary-hover);
}

.card h3 {
    margin: 14px 0 8px;
    font-size: 1.2rem;
}

.card p {
    color: var(--text-muted);
    font-size: 0.9rem;
}

.icon,
.icon img {
    width: 46px;
    height: 46px;
    border-radius: 8px;
}

.footer {
    padding: 35px 0;
    text-align: center;
    border-top: 1px solid var(--bg-soft);
    color: var(--text-dim);
    font-size: 0.85rem;
}

.tools-header {
    padding: 110px 0 35px;
    text-align: center;
}

.filter-group {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 25px;
}

.filter-input,
.filter-select {
    padding: 11px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background-color: var(--bg-soft);
    color: var(--text);
    font-size: 0.9rem;
}

.filter-input {
    width: 280px;
}

.tool-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 70px;
}

.tool-item {
    background-color: var(--bg-soft);
    border: 1px solid var(--border);
    padding: 18px;
    border-radius: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: inherit;
}

.tool-item:hover {
    border-color: var(--primary-hover);
    background-color: var(--bg-hover);
}

.tool-info h3 {
    font-size: 1.05rem;
    margin-bottom: 4px;
}

.tool-info p {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.category-tag {
    font-size: 0.65rem;
    text-transform: uppercase;
    font-weight: 600;
    padding: 3px 7px;
    border-radius: 4px;
    background: var(--border);
    color: var(--text);
    margin-left: 5px;
}

.link-tools {
    color: var(--primary-hover);
    font-size: 0.8rem;
    text-decoration: none;
    display: block;
    margin-top: 12px;
}

@media (max-width: 768px) {
    .nav-links {
        display: none;
    }

    .hero h1 {
        font-size: 2.4rem;
    }

    .filter-input {
        width: 100%;
    }
}
