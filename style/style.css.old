:root {
--bg: #0a0a0a;
--bg-soft: #111111;
--bg-hover: #1a1a1a;
--border: #222222;
--border-light: #333333;
--text: #ffffff;
--text-muted: #a0a0a0;
--text-dim: #666666;
--primary: #005fb8;
--primary-hover: #0078e7;
}

* {
margin: 0;
padding: 0;
box-sizing: border-box;
}

body {
background-color: var(--bg);
color: var(--text);
font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
line-height: 1.5;
}

.container {
max-width: 1100px;
margin: 0 auto;
padding: 0 20px;
}

.navbar {
position: fixed;
top: 0;
width: 100%;
z-index: 100;
padding: 12px 0;
background: #000000;
border-bottom: 1px solid var(--border);
}

.nav-container {
max-width: 1200px;
margin: 0 auto;
padding: 0 20px;
display: flex;
justify-content: space-between;
align-items: center;
}

.logo {
font-size: 1.1rem;
font-weight: 800;
text-transform: uppercase;
}

.nav-links {
display: flex;
gap: 24px;
}

.nav-links a {
color: var(--text-muted);
text-decoration: none;
font-size: 0.85rem;
font-weight: 500;
transition: color 0.2s ease;
}

.nav-links a:hover {
color: var(--text);
}

.btn-tools {
background-color: transparent;
color: var(--text);
text-decoration: none;
padding: 6px 12px;
border: 1px solid var(--border-light);
border-radius: 0px;
font-size: 0.8rem;
font-weight: 600;
transition: all 0.2s ease;
}

.btn-tools:hover {
background-color: var(--primary);
border-color: var(--primary);
}

.tools-header {
padding: 100px 0 40px;
text-align: center;
}

.filter-group {
display: flex;
gap: 10px;
justify-content: center;
flex-wrap: wrap;
margin-top: 25px;
}

.filter-input,
.filter-select {
padding: 10px 15px;
border-radius: 0px;
border: 1px solid var(--border-light);
background-color: var(--bg-soft);
color: var(--text);
font-size: 0.9rem;
}

.tool-list {
display: flex;
flex-direction: column;
gap: 15px;
margin-bottom: 60px;
}

.tool-item {
background-color: var(--bg-soft);
border: 1px solid var(--border);
padding: 20px;
border-radius: 0px;
display: flex;
justify-content: space-between;
align-items: center;
text-decoration: none;
color: inherit;
transition: all 0.2s ease;
}

.tool-item:hover {
background-color: var(--bg-hover);
border-color: var(--primary);
}

.tool-info h3 {
font-size: 1.1rem;
margin-bottom: 4px;
}

.tool-info p {
color: var(--text-muted);
font-size: 0.9rem;
}

.tool-tags {
display: flex;
gap: 8px;
flex-wrap: wrap;
}

.category-tag {
font-size: 0.7rem;
text-transform: uppercase;
font-weight: 700;
padding: 2px 8px;
border: 1px solid var(--border-light);
border-radius: 0px;
background: transparent;
color: var(--text-dim);
}

.footer {
padding: 40px 0;
text-align: center;
border-top: 1px solid var(--border);
color: var(--text-dim);
font-size: 0.85rem;
}

@media (max-width: 768px) {
.nav-links {
display: none;
}
.tool-item {
flex-direction: column;
align-items: flex-start;
gap: 15px;
}
.filter-input {
width: 100%;
}
}
